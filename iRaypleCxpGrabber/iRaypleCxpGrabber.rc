/////////////////////////////////////////////////////////////////////////////
//
// 아이콘
//

// 애플리케이션 아이콘이 모든 시스템에서 일관된 상태를 유지하도록 하기 위해
// 가장 낮은 ID 값을 갖는 아이콘이 맨 처음 배치됩니다.
IDR_MAINFRAME           ICON         "res\\iRaypleCxpGrabber.ico"


#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_KOR)
LANGUAGE 18, 1

/////////////////////////////////////////////////////////////////////////////
//
// 대화 상자
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iRaypleCxpGrabber 정보"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "iRaypleCxpGrabber, 버전 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "확인",IDOK,113,41,50,14,WS_GROUP
END

IDD_IRAYPLECXPGRABBER_DIALOG DIALOGEX  0, 0, 760, 470
STYLE DS_SHELLFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION
 | WS_THICKFRAME
 | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "iRayple CXP Grabber"
FONT 9, "MS Shell Dlg"
BEGIN
    CONTROL         "",IDC_VIEW_WND,"Static",SS_BLACKFRAME | WS_TABSTOP,10,10,570,420
    PUSHBUTTON      "Connect",IDC_BTN_CONNECT,596,18,140,24
    PUSHBUTTON      "Start Grab",IDC_BTN_START,596,50,66,24
    PUSHBUTTON      "Stop",IDC_BTN_STOP,670,50,66,24
    PUSHBUTTON      "Snap",IDC_BTN_SNAP,596,82,140,24
    AUTOCHECKBOX    "Software trigger mode",IDC_CHECK_TRIGGER,596,124,140,12
    PUSHBUTTON      "Software Trigger",IDC_BTN_SW_TRIGGER,596,144,140,24
    AUTOCHECKBOX    "Bayer CPU Debayer",IDC_CHECK_BAYER,596,174,140,12
    LTEXT           "Exposure (us)",IDC_STATIC_EXPOSURE,596,206,80,10
    EDITTEXT        IDC_EDIT_EXPOSURE,596,220,86,18,ES_AUTOHSCROLL
    PUSHBUTTON      "Set",IDC_BTN_SET_EXPOSURE,690,219,46,20
    LTEXT           "Not connected",IDC_STATIC_STATUS,10,438,726,20,SS_SUNKEN
END

/////////////////////////////////////////////////////////////////////////////
//
// 버전
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "TODO: <회사 이름>"
            VALUE "FileDescription", "iRaypleCxpGrabber"
            VALUE "FileVersion",     "1.0.0.1"
            VALUE "InternalName",    "iRaypleCxpGrabber.exe"
            VALUE "LegalCopyright", "TODO: (c) <회사 이름>.  All rights reserved."
            VALUE "OriginalFilename","iRaypleCxpGrabber.exe"
            VALUE "ProductName", "TODO: <제품 이름>"
            VALUE "ProductVersion",  "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END

